{
    "manufacturer": "Constantine Beniaris",
    "keyboard_name": "magsplit_dial",
    "maintainer": "Cbeniaris",
    "development_board": "promicro",
    "features": {
        "encoder": true
    },
    "matrix_pins": {
        "direct": [
            ["F4", "D4", "F5", "C6", "B1"]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "B2", "pin_b": "B3", "resolution": 4}
        ]
    },
    "debounce": 5,
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 2, "y": 0},
                {"matrix": [0, 2], "x": 0, "y": 2},
                {"matrix": [0, 3], "x": 2, "y": 2},
                {"matrix": [0, 4], "x": 1, "y": 1}
            ]
        }
    }
}